{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "properties": {
        "Employee": {
            "$ref": "#/definitions/Employee"
        }
    },
    "required": [
        "Employee"
    ],
    "title": "Employee",
    "definitions": {
        "Employee": {
            "$id": "#/properties/Employee",
            "type": "object",
            "title": "The Employee Schema",
            "required": [
                "identityDetails",
                "contactDetails"
            ],
            "properties": {
                "identityDetails": {
                    "type": "object",
                    "required": [
                        "fullName"
                    ],
                    "properties": {
                        "fullName": {
                            "type": "string"
                        },
                        "employeeNumber": {
                            "type": "string"
                        },
                        "personId": {
                            "type": "integer"
                        }
                    }
                },
                "contactDetails": {
                    "type": "object",
                    "required": [
                        "email"
                    ],
                    "properties": {
                        "email": {
                            "type": "string",
                            "format": "email"
                        },
                        "mobile": {
                            "type": "string"
                        }
                    }
                },
                "systemDetails": {
                    "type": "object",
                    "properties": {
                        "role": {
                            "type": "string",
                            "enum": [
                                "admin",
                                "employee"
                            ],
                            "default": "employee"
                        },
                        "backendPassword": {
                            "type": "string"
                        }
                    }
                },
                "employmentDetails": {
                    "type": "object",
                    "properties": {
                        "employeeId": {
                            "type": "integer"
                        },
                        "companyId": {
                            "type": "integer"
                        },
                        "departmentId": {
                            "type": "integer"
                        },
                        "positionId": {
                            "type": "integer"
                        },
                        "employeeTypeId": {
                            "type": "integer"
                        },
                        "admissionDate": {
                            "type": "string",
                            "format": "date"
                        },
                        "contractExpiration": {
                            "type": "string",
                            "format": "date"
                        },
                        "salary": {
                            "type": "number"
                        },
                        "status": {
                            "type": "boolean",
                            "default": true
                        }
                    }
                }
            }
        }
    },
    "_osConfig": {
        "uniqueIndexFields": [
            "contactDetails.email"
        ],
        "indexFields": [
            "identityDetails.employeeNumber",
            "contactDetails.email",
            "systemDetails.role"
        ],
        "ownershipAttributes": [
            {
                "email": "/contactDetails/email",
                "mobile": "/contactDetails/mobile",
                "userId": "/contactDetails/email"
            }
        ],
        "roles": [
            "admin",
            "employee"
        ],
        "privateFields": [
            "$.employmentDetails.salary",
            "$.systemDetails.backendPassword"
        ],
        "systemFields": [
            "_osCreatedAt",
            "_osUpdatedAt",
            "_osCreatedBy",
            "_osUpdatedBy",
            "_osState",
            "_osAttestedData"
        ]
    }
}